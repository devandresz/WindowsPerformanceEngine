<Window x:Class="WindowsPerformanceEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Performance Engine" Height="800" Width="1400"
        Background="#0F111A" Foreground="#F8FAFC" WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Poppins, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Base Shadow for depth -->
        <DropShadowEffect x:Key="DarkZenShadow" BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="#000000" Direction="270"/>
        
        <!-- Glowing Shadow for hover effects -->
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="#64FFDA"/>
        
        <Style x:Key="ZenCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0DFFFFFF"/>
            <Setter Property="Effect" Value="{StaticResource DarkZenShadow}"/>
        </Style>

        <Style x:Key="ZenPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#64FFDA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0DFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="25" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTrans" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24283B"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.05" />
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.05" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZenSidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Margin="10,0,10,5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24283B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Background="#0F111A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/> <!-- Why Engine Panel -->
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0" Effect="{StaticResource DarkZenShadow}">
            <StackPanel Margin="0,25,0,0">
                <TextBlock Text="W.P.E." Foreground="#64FFDA" FontSize="34" FontWeight="SemiBold" Margin="25,0,0,35"/>
                
                <Button x:Name="BtnDashboard" Style="{StaticResource ZenSidebarButtonStyle}" Content="DASHBOARD" Height="55" FontSize="14" Click="BtnDashboard_Click"/>
                <Button x:Name="BtnProcesos" Style="{StaticResource ZenSidebarButtonStyle}" Content="PROCESOS EN SEGUNDO PLANO" Height="55" FontSize="14" Click="BtnProcesos_Click"/>
                <Button x:Name="BtnOptimizaciones" Style="{StaticResource ZenSidebarButtonStyle}" Content="OPTIMIZACIONES" Height="55" FontSize="14" Click="BtnOptimizaciones_Click"/>
                <Button x:Name="BtnPruebas" Style="{StaticResource ZenSidebarButtonStyle}" Content="RENDIMIENTO Y RED" Height="55" FontSize="14" Click="BtnPruebas_Click"/>
                <Button x:Name="BtnHistorial" Style="{StaticResource ZenSidebarButtonStyle}" Content="HISTORIAL &amp; ROLLBACK" Height="55" FontSize="14" Click="BtnHistorial_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="SYSTEM STATUS &amp; TELEMETRY" FontSize="26" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkSimulacion" Content="MODO SIMULACIÓN (DRY-RUN)" Foreground="#94A3B8" FontWeight="Normal" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
            </Grid>
            
            <!-- Contenedor general animado -->
            <Border x:Name="ContenedorVistas" Grid.Row="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="VistaTranslate" Y="0"/>
                </Border.RenderTransform>
                
                <!-- ESTRICTA SEPARACIÓN ESTRUCTURAL -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Dashboard Row -->
                        <RowDefinition Height="*"/>    <!-- Contenido dinámico / Consola Row -->
                    </Grid.RowDefinitions>
                    
                    <!-- Telemetry Cards (Fila 0) -->
                    <WrapPanel x:Name="PnlDashboard" Grid.Row="0" Orientation="Horizontal" Visibility="Visible">
                        <!-- CPU Card -->
                        <Border Style="{StaticResource ZenCardStyle}" Width="320">
                            <StackPanel>
                                <TextBlock Text="PROCESADOR" Foreground="#94A3B8" FontSize="13" FontWeight="Normal"/>
                                <TextBlock x:Name="TxtProcesador" Text="Analizando..." Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- RAM Card -->
                        <Border Style="{StaticResource ZenCardStyle}" Width="320">
                            <StackPanel>
                                <TextBlock Text="MEMORIA RAM" Foreground="#94A3B8" FontSize="13" FontWeight="Normal"/>
                                <TextBlock x:Name="TxtRam" Text="Analizando..." Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- GPU Card -->
                        <Border Style="{StaticResource ZenCardStyle}" Width="320">
                            <StackPanel>
                                <TextBlock Text="GPU &amp; MONITOR" Foreground="#94A3B8" FontSize="13" FontWeight="Normal"/>
                                <TextBlock x:Name="TxtGpu" Text="Analizando..." Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- OS Card -->
                        <Border Style="{StaticResource ZenCardStyle}" Width="320">
                            <StackPanel>
                                <TextBlock Text="SISTEMA OPERATIVO" Foreground="#94A3B8" FontSize="13" FontWeight="Normal"/>
                                <TextBlock x:Name="TxtOs" Text="Analizando..." Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    
                    <!-- Output Area (Fila 1) -->
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- La consola siempre es visible pero separada -->
                            <TextBlock Text="CONSOLA Y CENTRO DE ACCIÓN" Foreground="#94A3B8" FontSize="15" FontWeight="Normal" Margin="0,0,0,12"/>
                            <Border Background="#0F111A" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="20" CornerRadius="16">
                                <TextBlock x:Name="TxtConsola" Text="Esperando acciones..." Foreground="#94A3B8" FontSize="14" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Border>
                            
                            <!-- Botón global (se muestra solo en Optimizaciones) -->
                            <Button x:Name="BtnAplicarOptimizaciones" Content="APLICAR Y AUDITAR (EXPORTAR REPORTE)" Style="{StaticResource ZenPrimaryButtonStyle}" FontSize="15" Height="55" Margin="0,20,0,0" Visibility="Collapsed" Click="BtnAplicarOptimizaciones_Click"/>
                            
                            <!-- Visual Benchmark Panel -->
                            <Border x:Name="PnlGraficosBenchmark" Style="{StaticResource ZenCardStyle}" Margin="0,20,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="MÉTRICAS ETW GRÁFICAS (ANTES VS DESPUÉS)" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                    
                                    <!-- Controles de Red y Baseline -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="Destino de Prueba:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox x:Name="TxtHostPing" Grid.Column="1" Text="8.8.8.8" Background="#0F111A" Foreground="#F8FAFC" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="8" VerticalAlignment="Center"/>
                                        
                                        <Button x:Name="BtnTomarBaseline" Grid.Column="3" Content="Tomar Baseline" Style="{StaticResource ZenPrimaryButtonStyle}" Click="BtnTomarBaseline_Click"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="FPS Promedio (DWM/Global):" Foreground="#F8FAFC"/>
                                        <ProgressBar x:Name="PbFps" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" Height="10" Foreground="#64FFDA" Background="#0F111A" BorderThickness="0"/>
                                        <TextBlock x:Name="TxtFpsValor" Grid.Column="2" Text="0" Foreground="#64FFDA" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1% Lows (DWM):" Foreground="#F8FAFC"/>
                                        <ProgressBar x:Name="PbLows" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" Height="10" Foreground="#00D8FF" Background="#0F111A" BorderThickness="0"/>
                                        <TextBlock x:Name="TxtLowsValor" Grid.Column="2" Text="0" Foreground="#00D8FF" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Frametime (ms):" Foreground="#F8FAFC"/>
                                        <ProgressBar x:Name="PbFrametime" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="10" Foreground="#94A3B8" Background="#0F111A" BorderThickness="0"/>
                                        <TextBlock x:Name="TxtFrametimeValor" Grid.Column="2" Text="0" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Dynamic Optimizations List Area -->
                            <StackPanel x:Name="PnlOptimizacionesWrapper" Margin="0,20,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnEvaluarSistema" Content="EVALUAR SISTEMA (ESCANEO WMI)" Style="{StaticResource ZenPrimaryButtonStyle}" Margin="0,0,0,20" Click="BtnEvaluarSistema_Click"/>
                                
                                <ItemsControl x:Name="LstOptimizaciones">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ZenCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Decision}" Foreground="#64FFDA" FontSize="14" Margin="0,5,0,0"/>
                                                        <CheckBox Content="Autorizar Ejecución Peligrosa" IsChecked="{Binding EstaAutorizada}" Visibility="{Binding MostrarBotonAutorizar, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#FF6464" FontWeight="Normal" Margin="0,10,0,0" Checked="ChkAutorizar_Checked" Unchecked="ChkAutorizar_Checked" Tag="{Binding ReglaId}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Why Engine?" Tag="{Binding ReglaId}" Click="BtnWhyEngine_Click" Style="{StaticResource ZenPrimaryButtonStyle}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <!-- Historial & Rollback List Area -->
                            <StackPanel x:Name="PnlHistorialWrapper" Margin="0,20,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnRevertirTodo" Content="REVERTIR TODAS LAS TRANSACCIONES" Style="{StaticResource ZenPrimaryButtonStyle}" Margin="0,0,0,20" Click="BtnRevertirTodo_Click"/>
                                
                                <ItemsControl x:Name="LstHistorial">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ZenCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NombreRegla}" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding IdTransaccion, StringFormat='Hash: {0}'}" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding FechaEjecucion, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#94A3B8" FontSize="13" Margin="0,5,0,0"/>
                                                        <TextBlock Foreground="#00D8FF" FontSize="14" Margin="0,5,0,0">
                                                            <Run Text="Anterior: "/>
                                                            <Run Text="{Binding ValorAnterior}" FontWeight="SemiBold"/>
                                                            <Run Text=" -> Nuevo: "/>
                                                            <Run Text="{Binding ValorNuevo}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding TextoBoton}" Tag="{Binding IdTransaccion}" Click="BtnRevertir_Click" Style="{StaticResource ZenPrimaryButtonStyle}" IsEnabled="{Binding PuedeRevertir}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Background Processes Area -->
                            <StackPanel x:Name="PnlProcesosWrapper" Margin="0,20,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnEscanearProcesos" Content="ESCANEAR PROCESOS AHORA" Style="{StaticResource ZenPrimaryButtonStyle}" Margin="0,0,0,20" Click="BtnEscanearProcesos_Click"/>
                                
                                <ItemsControl x:Name="LstProcesos">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ZenCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Nombre}" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Categoria}" Foreground="#64FFDA" FontSize="14" FontWeight="Normal" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding MemoriaMb, StringFormat='{}Memoria: {0} MB'}" Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Recomendacion}" Foreground="#00D8FF" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Why Engine Panel (Right Sidebar) -->
        <Border x:Name="PanelWhyEngine" Grid.Column="2" Width="420" Background="#1A1D27" BorderBrush="#0DFFFFFF" BorderThickness="1,0,0,0" Effect="{StaticResource DarkZenShadow}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="WHY ENGINE" Foreground="#64FFDA" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="22" Cursor="Hand" Click="BtnCerrarWhyEngine_Click"/>
                    </Grid>
                    
                    <TextBlock x:Name="WhyTitulo" Text="Regla Nombre" Foreground="#F8FAFC" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="WhyDescripcion" Text="Descripción..." Foreground="#94A3B8" FontSize="15" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,25"/>
                    
                    <Border Background="#0F111A" BorderBrush="#0DFFFFFF" BorderThickness="1" Padding="25" CornerRadius="16" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="JUSTIFICACIÓN TÉCNICA" Foreground="#64FFDA" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock x:Name="WhyExplicacion" Text="Evidencia..." Foreground="#F8FAFC" FontSize="14" FontWeight="Normal" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CONFIANZA" Foreground="#94A3B8" FontSize="13" FontWeight="Normal"/>
                            <TextBlock x:Name="WhyConfianza" Text="100%" Foreground="#64FFDA" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RIESGO" Foreground="#94A3B8" FontSize="13" FontWeight="Normal"/>
                            <TextBlock x:Name="WhyRiesgo" Text="SAFE" Foreground="#64FFDA" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="FUENTES (EVIDENCIA)" Foreground="#64FFDA" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="WhyFuentes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#F8FAFC" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="• "/><Run Text="{Binding Autor}" FontWeight="SemiBold"/>: <Run Text="{Binding Descripcion}" Foreground="#94A3B8"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
